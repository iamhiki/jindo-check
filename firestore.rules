rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 초대 코드 목록: 앱에서는 읽거나 쓸 수 없어요. Firebase 콘솔에서만 관리해요.
    // 문서 ID가 곧 초대 코드예요. (예: invites/hunter2026)
    match /invites/{code} {
      allow read, write: if false;
    }

    // 가입 확인: 맞는 초대 코드를 넣은 사람만 자기 문서를 만들 수 있어요.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.code));
    }

    // 기록: 가입이 확인된 본인만 users/<자기 uid>/ 아래를 읽고 쓸 수 있어요.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/members/$(uid));
    }

    // 선생님께 공유하는 연습 리포트: reports/<랜덤 토큰>
    // - 링크(토큰)를 아는 사람은 로그인 없이 그 문서 하나만 볼 수 있어요. 목록 조회는 막아서 남의 링크를 찾을 수 없어요.
    // - 만들고 고치고 지우는 건 가입한 학생 본인만 할 수 있어요.
    match /reports/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && token.size() >= 20
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'owner', 'nickname', 'updatedAt', 'songs', 'lessons'])
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'owner', 'nickname', 'updatedAt', 'songs', 'lessons']);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // 같이 보는 레슨 일정: 공유를 켜면 학생의 레슨 일정이 여기로 옮겨와요.
      // 링크를 아는 선생님(앱이 없어도)과 학생이 같이 추가·수정·삭제할 수 있어요.
      match /lessons/{lessonId} {
        allow read: if true;
        allow create, update: if exists(/databases/$(database)/documents/reports/$(token))
          && lessonId.size() <= 40
          && request.resource.data.keys().hasOnly(['at', 'memo', 'by'])
          && request.resource.data.at is string
          && request.resource.data.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
          && request.resource.data.memo is string && request.resource.data.memo.size() <= 300
          && request.resource.data.by is string && request.resource.data.by.size() <= 20;
        allow delete: if exists(/databases/$(database)/documents/reports/$(token));
      }

      // 선생님 한마디: 링크를 아는 사람은 누구나 짧은 글을 남길 수 있고, 학생 본인만 지울 수 있어요.
      match /notes/{noteId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/reports/$(token))
          && request.resource.data.keys().hasOnly(['name', 'text', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/reports/$(token)).data.owner == request.auth.uid;
      }
    }
  }
}
